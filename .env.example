# Copy this file to .env and adjust values as needed

SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# Database: set DB_ENGINE=mysql to use MySQL, otherwise SQLite is used automatically
DB_ENGINE=sqlite
DB_NAME=code_review_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Optional: enable real GPT-based reviews (falls back to static analysis if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
